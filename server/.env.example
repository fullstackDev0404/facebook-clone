# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/facebook_clone"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# Server
PORT=6000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Email Configuration (for email verification)
# Leave EMAIL_USER empty in development to skip email sending (verification URL will be logged to console)

# Option 1: Gmail (recommended for development)
#   1. Enable 2-Factor Authentication on your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an app password (select "Mail" and "Other (Custom name)")
#   4. Use the 16-character app password below (NOT your regular password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="Facebook Clone <your-email@gmail.com>"

# Option 2: Outlook/Hotmail (requires enabling SMTP auth in Outlook settings)
#   1. Go to https://outlook.com → Settings → View all Outlook settings
#   2. Mail → Sync email → Enable "Authenticated SMTP"
#   3. Use your regular password
# EMAIL_SERVICE=outlook
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-regular-password
# EMAIL_FROM="Facebook Clone <your-email@outlook.com>"

# Option 3: Ethereal Email (free testing service - no real email sent)
#   1. Visit https://ethereal.email to create a free account
#   2. Use the credentials provided
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-ethereal-username
# EMAIL_PASS=your-ethereal-password
# EMAIL_FROM="Facebook Clone <your-ethereal-email@ethereal.email>"

# Google OAuth
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5001/api/auth/google/callback"

# Microsoft OAuth
# Get these from https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_CALLBACK_URL="http://localhost:5001/api/auth/microsoft/callback"
